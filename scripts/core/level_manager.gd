extends Node

const GOD_MODE: bool = false 

func debug_reset_save() -> void:
	max_unlocked_level = 0
	save_progress()
	print("[DEV] Save file wiped. Progress reset to Level 1.")

const SAVE_FILE_PATH: String = "user://savegame.dat"
var max_unlocked_level: int = 0
var current_level_index: int = 0

func _ready() -> void:
	# debug_reset_save()
	load_progress()

func save_progress() -> void:
	var file = FileAccess.open(SAVE_FILE_PATH, FileAccess.WRITE)
	if file:
		file.store_32(max_unlocked_level)
		file.close()

func load_progress() -> void:
	if FileAccess.file_exists(SAVE_FILE_PATH):
		var file = FileAccess.open(SAVE_FILE_PATH, FileAccess.READ)
		if file:
			max_unlocked_level = file.get_32()
			file.close()
			print("[SAVE] Progress loaded. Max unlocked level: ", max_unlocked_level + 1)
	else:
		print("[SAVE] No save file found. Starting fresh.")

func unlock_next_level(just_beaten_index: int) -> void:
	if just_beaten_index >= max_unlocked_level:
		max_unlocked_level = just_beaten_index + 1
		save_progress()
		print("[SAVE] Game Saved! Unlocked level: ", max_unlocked_level + 1)


